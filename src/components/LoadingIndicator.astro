<div id="loading-indicator"></div>

<script>
  import { m3anim } from '../utils/consts';
  // Astro 打包的 module script 全站只执行一次；不要在 astro:page-load 里重复注册
  // 事件，否则监听器随导航次数累积，多份闭包同时驱动同一元素导致进度条来回抖动
  let widthAnim: Animation | undefined;
  // 导航期间为 true：page-load 时据此判断这轮要不要收尾，初次加载不出进度条
  let finishing = false;

  const indicator = () => document.getElementById('loading-indicator');

  // 起点必须在 cancel 旧动画前采样，否则会拿到清零后的基础值导致进度条回跳
  const currentWidthPct = (el: HTMLElement) => {
    const px = parseFloat(getComputedStyle(el).width);
    return (px / document.documentElement.clientWidth) * 100;
  };

  const animateWidth = (to: number, duration: number, easing: string, onfinish?: () => void) => {
    const el = indicator();
    if (!el) return;
    const from = currentWidthPct(el);
    widthAnim?.cancel();
    widthAnim = el.animate([{ width: `${from}%` }, { width: `${to}%` }], {
      duration,
      easing,
      fill: 'forwards',
    });
    if (onfinish) widthAnim.addEventListener('finish', onfinish, { once: true });
  };

  document.addEventListener('astro:before-preparation', () => {
    const el = indicator();
    if (!el) return;
    const from = currentWidthPct(el);
    // 清掉上一轮的 fill:forwards 动画，基础宽度停在当前进度，回落动画才不会跳变
    el.getAnimations().forEach((a) => a.cancel());
    el.style.width = `${from}%`;
    el.style.opacity = '';
    const climb = () => {
      animateWidth(30, 400, 'ease-out', () => {
        // 等待期缓慢爬升而不是停在原地，避免用户误以为页面卡死
        animateWidth(90, 8000, 'linear');
      });
    };
    // 爬到一半改点别的链接时，先把这一轮的进度快速收回 0 再重新爬升
    if (from > 1) animateWidth(0, 80, 'ease-out', climb);
    else climb();
  });

  // 交换后的条以 100% 入场，视图过渡的形变会把它从爬升宽度平滑拉满，无需自己补动画
  document.addEventListener('astro:before-swap', (event) => {
    finishing = true;
    const next = event.newDocument.getElementById('loading-indicator');
    if (next) next.style.width = '100%';
  });

  const settle = () => {
    const el = indicator();
    if (!el) return;
    // 过渡覆盖层退场后真实元素才可见，此时从 100% 淡出再复位
    const fade = el.animate([{ opacity: 0 }], {
      duration: m3anim.expressiveSlowEffects.duration,
      easing: 'ease-in',
      fill: 'forwards',
    });
    fade.addEventListener(
      'finish',
      () => {
        el.getAnimations().forEach((a) => a.cancel());
        el.style.width = '0%';
        el.style.opacity = '';
      },
      { once: true },
    );
  };

  // page-load 只代表 DOM 交换完成、覆盖层还在，等 Astro 摘掉过渡标记再淡出
  const settleAfterTransition = () => {
    if (document.documentElement.hasAttribute('data-astro-transition')) {
      requestAnimationFrame(settleAfterTransition);
      return;
    }
    finishing = false;
    settle();
  };

  document.addEventListener('astro:page-load', () => {
    if (finishing) settleAfterTransition();
  });
</script>

<style lang="stylus">
  #loading-indicator {
    position: fixed;
    top: 0;
    left: 0;
    height: 4px;
    width: 0;
    opacity: 0.5;
    border-radius: 2px;
    background: linear-gradient(to right, var(--primary-container), var(--primary), var(--secondary));
    z-index: 1000;
    view-transition-name: loading-indicator;
  }
</style>
