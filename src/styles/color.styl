hue = var(--color-hue, 0)
redhue = 25
selectionhue = "calc(%s + 45)" % hue

// ── 主调色板（OKLCH，现代浏览器）─────────────────────────────────
// 语义色：light → dark 两个值，色相由 var(--color-hue) 动态注入。
// 半透明 token（--*-72/60/65/8/22/15/78）：替代 color-mix()，
// 让不支持 color-mix 的旧浏览器也能获得半透明色。
palette = {
  surface-hover: oklch(92% 1% hue)   oklch(24% 1% hue)
  primary:    oklch(58% 22% hue)     oklch(72% 20% hue)
  secondary:  oklch(55% 18% hue)     oklch(68% 16% hue)
  background: oklch(99% 0.5% hue)    oklch(11% 1% hue)
  surface:    oklch(97% 0.8% hue)    oklch(16% 1% hue)
  border:     oklch(90% 1% hue)      oklch(28% 1.5% hue)
  text:       oklch(25% 1.5% hue)    oklch(93% 1% hue)
  text-muted: oklch(45% 2% hue)      oklch(72% 1.5% hue)
  nav:        oklch(98% 0.6% hue)    oklch(14% 1% hue)

  primary-container:    oklch(93% 3% hue)   oklch(26% 4% hue)
  on-primary-container: oklch(35% 20% hue)  oklch(90% 12% hue)
  secondary-container:  oklch(92% 3% hue)   oklch(22% 3.5% hue)
  on-secondary-container: oklch(35% 20% hue) oklch(88% 10% hue)
  surface-container:    oklch(96% 0.8% hue) oklch(20% 1% hue)
  on-surface-container: oklch(25% 1.5% hue) oklch(92% 1% hue)
  container:            oklch(99% 0.3% hue) oklch(13% 0.8% hue)
  on-container:         oklch(25% 1.5% hue) oklch(92% 1% hue)

  error:            oklch(55% 18% redhue) oklch(70% 16% redhue)
  error-container:  oklch(93% 3% redhue)  oklch(28% 6% redhue)
  on-error:         oklch(100% 0% redhue) oklch(0% 0% redhue)
  on-error-container: oklch(35% 14% redhue) oklch(92% 6% redhue)

  selection-text:       oklch(45% 12% selectionhue) oklch(85% 10% selectionhue)
  selection-background: oklch(90% 6% selectionhue)  oklch(32% 10% selectionhue)

  shadow: oklch(0% 0% hue \/ 0.08) oklch(0% 0% hue \/ 0.3)

  meta-bg: oklch(94% 1% hue \/ 0.5) oklch(26% 2% hue \/ 0.4)

  // 半透明 token（原 color-mix 语义）：
  // primary-container 72% / text 15% / border 60% / surface 78%
  // on-error-container 65%、8%、22%
  primary-container-72: oklch(93% 3% hue \/ 0.72) oklch(26% 4% hue \/ 0.72)
  text-15:              oklch(25% 1.5% hue \/ 0.15) oklch(93% 1% hue \/ 0.15)
  border-60:            oklch(90% 1% hue \/ 0.6)   oklch(28% 1.5% hue \/ 0.6)
  surface-78:           oklch(97% 0.8% hue \/ 0.78) oklch(16% 1% hue \/ 0.78)
  on-error-container-65: oklch(35% 14% redhue \/ 0.65) oklch(92% 6% redhue \/ 0.65)
  on-error-container-8:  oklch(35% 14% redhue \/ 0.08) oklch(92% 6% redhue \/ 0.08)
  on-error-container-22: oklch(35% 14% redhue \/ 0.22) oklch(92% 6% redhue \/ 0.22)
}

// ── HSL 回退调色板（旧浏览器：不支持 oklch / color-mix）────────────
// 结构与 palette 完全一致：[0]=light, [1]=dark。
// 色相同样由 var(--color-hue) 动态注入 → 旧浏览器色相滑块仍可用；
// error 固定 25；selection hue +45。值以字符串字面量给出。
fallback-palette = {
  surface-hover: "hsl(var(--color-hue, 0), 8%, 92%)"   "hsl(var(--color-hue, 0), 8%, 24%)"
  primary:       "hsl(var(--color-hue, 0), 65%, 58%)"  "hsl(var(--color-hue, 0), 65%, 72%)"
  secondary:     "hsl(var(--color-hue, 0), 55%, 55%)"  "hsl(var(--color-hue, 0), 55%, 68%)"
  background:    "hsl(var(--color-hue, 0), 5%, 99%)"   "hsl(var(--color-hue, 0), 8%, 11%)"
  surface:       "hsl(var(--color-hue, 0), 7%, 97%)"   "hsl(var(--color-hue, 0), 8%, 16%)"
  border:        "hsl(var(--color-hue, 0), 8%, 90%)"   "hsl(var(--color-hue, 0), 10%, 28%)"
  text:          "hsl(var(--color-hue, 0), 8%, 25%)"   "hsl(var(--color-hue, 0), 7%, 93%)"
  text-muted:    "hsl(var(--color-hue, 0), 10%, 45%)"  "hsl(var(--color-hue, 0), 10%, 72%)"
  nav:           "hsl(var(--color-hue, 0), 6%, 98%)"   "hsl(var(--color-hue, 0), 8%, 14%)"

  primary-container:    "hsl(var(--color-hue, 0), 18%, 93%)" "hsl(var(--color-hue, 0), 25%, 26%)"
  on-primary-container: "hsl(var(--color-hue, 0), 60%, 35%)" "hsl(var(--color-hue, 0), 40%, 90%)"
  secondary-container:  "hsl(var(--color-hue, 0), 16%, 92%)" "hsl(var(--color-hue, 0), 22%, 22%)"
  on-secondary-container: "hsl(var(--color-hue, 0), 60%, 35%)" "hsl(var(--color-hue, 0), 35%, 88%)"
  surface-container:    "hsl(var(--color-hue, 0), 6%, 96%)"   "hsl(var(--color-hue, 0), 8%, 20%)"
  on-surface-container: "hsl(var(--color-hue, 0), 8%, 25%)"   "hsl(var(--color-hue, 0), 7%, 92%)"
  container:            "hsl(var(--color-hue, 0), 4%, 99%)"   "hsl(var(--color-hue, 0), 7%, 13%)"
  on-container:         "hsl(var(--color-hue, 0), 8%, 25%)"   "hsl(var(--color-hue, 0), 7%, 92%)"

  error:              "hsl(25, 55%, 55%)" "hsl(25, 50%, 70%)"
  error-container:    "hsl(25, 18%, 93%)" "hsl(25, 30%, 28%)"
  on-error:           "hsl(25, 0%, 100%)" "hsl(25, 0%, 0%)"
  on-error-container: "hsl(25, 45%, 35%)" "hsl(25, 30%, 92%)"

  selection-text:       "hsl(calc(var(--color-hue, 0) + 45), 45%, 45%)" "hsl(calc(var(--color-hue, 0) + 45), 35%, 85%)"
  selection-background: "hsl(calc(var(--color-hue, 0) + 45), 25%, 90%)" "hsl(calc(var(--color-hue, 0) + 45), 30%, 32%)"

  shadow: "hsla(var(--color-hue, 0), 0%, 0%, 0.08)" "hsla(var(--color-hue, 0), 0%, 0%, 0.3)"

  meta-bg: "hsla(var(--color-hue, 0), 8%, 94%, 0.5)" "hsla(var(--color-hue, 0), 12%, 26%, 0.4)"

  // 半透明 token 的 HSL 版本
  primary-container-72: "hsla(var(--color-hue, 0), 18%, 93%, 0.72)" "hsla(var(--color-hue, 0), 25%, 26%, 0.72)"
  text-15:              "hsla(var(--color-hue, 0), 8%, 25%, 0.15)"  "hsla(var(--color-hue, 0), 7%, 93%, 0.15)"
  border-60:            "hsla(var(--color-hue, 0), 8%, 90%, 0.6)"   "hsla(var(--color-hue, 0), 10%, 28%, 0.6)"
  surface-78:           "hsla(var(--color-hue, 0), 7%, 97%, 0.78)"  "hsla(var(--color-hue, 0), 8%, 16%, 0.78)"
  on-error-container-65: "hsla(25, 45%, 35%, 0.65)" "hsla(25, 30%, 92%, 0.65)"
  on-error-container-8:  "hsla(25, 45%, 35%, 0.08)" "hsla(25, 30%, 92%, 0.08)"
  on-error-container-22: "hsla(25, 45%, 35%, 0.22)" "hsla(25, 30%, 92%, 0.22)"
}
